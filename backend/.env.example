# SQLite for local dev (default). Production uses PostgreSQL via DATABASE_URL on Render.
# DATABASE_URL=sqlite:///./saved_games.db

# JWT signing secret — must match frontend AUTH_SECRET in production.
# JWT_SECRET=your-long-random-secret

# Shared site password. The demo account is used behind the scenes.
# ACCESS_PASSWORD=pregame
# ADMIN_EMAIL=demo@bouncepass.net
# ALLOW_REGISTRATION=false

# Comma-separated frontend origins
# ALLOWED_ORIGINS=https://bouncepass.net,https://www.bouncepass.net,http://localhost:3000
